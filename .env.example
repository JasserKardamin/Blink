# Copie ce fichier en .env et remplis ce dont tu as besoin. Tout est optionnel en développement.

# --- Django ---
# SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
# DEBUG=1

# --- IA ---
GEMINI_API_KEY=
# Modèle Gemini (gemini-2.5-flash n'est plus ouvert aux nouvelles clés)
GEMINI_MODEL=gemini-3.5-flash
HF_TOKEN=

# --- E-mail (réinitialisation du mot de passe) ---
# Sans EMAIL_HOST, les e-mails sont affichés dans le terminal de runserver.
# Exemple Gmail : activer la validation en 2 étapes du compte Google, puis créer
# un « mot de passe d'application » sur https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=ton.adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-d-application-16-caracteres
DEFAULT_FROM_EMAIL=Blink <ton.adresse@gmail.com>

# --- Double authentification ---
# Nom affiché dans l'application d'authentification (Google Authenticator…)
# TWO_FACTOR_ISSUER=Blink
