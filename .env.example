# --- Django ---------------------------------------------------------------
SECRET_KEY=change-moi-en-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de données : SQLite par défaut. Pour PostgreSQL :
# DATABASE_URL=postgres://blink:blink@localhost:5432/blink

# --- Intelligence artificielle (optionnel : sans clé, Blink utilise ses moteurs locaux)
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Jeton Hugging Face (lecture + Inference) : https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_WHISPER_MODEL=openai/whisper-large-v3
